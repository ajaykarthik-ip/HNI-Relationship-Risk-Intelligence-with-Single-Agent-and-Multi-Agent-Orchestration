# One .gitignore for the whole repository: backend/ and
# affluense-risk-analysis/ have none of their own.

# --- secrets -----------------------------------------------------------------
# backend/.env holds the real Firecrawl and OpenAI keys. A key pushed once is
# a key that has to be rotated, so this block comes first.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
.vercel

# --- dependencies and build output -------------------------------------------
# ~1.1 GB between them, all reproducible from the lockfiles.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
coverage/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- caches ------------------------------------------------------------------
# backend/.cache holds raw API responses from real runs, including whatever
# those pages contained. Not secret, but not ours to redistribute either.
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.tsbuildinfo
.eslintcache

# Next.js regenerates this on every dev run.
next-env.d.ts

# --- generated reports -------------------------------------------------------
# Every run writes <name>.json and <name>.csv about a real, named individual.
# That is adverse-media research about living people: keep it local.
backend/*.json
backend/*.csv
backend/archive/*.json
!backend/requirements.json
# The V1 hash baseline. Not a report -- it is what makes "V1 is unchanged"
# a check a machine performs rather than a promise a person remembers, so it
# has to travel with the repository.
!backend/v1-manifest.json

# bench.py gives each engine its own cold cache. Those hold fetched article
# bodies about real named individuals -- the same reason the reports above stay
# local.
backend/.cache-bench/
.cache-bench/

# --- editor and OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# --- logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
