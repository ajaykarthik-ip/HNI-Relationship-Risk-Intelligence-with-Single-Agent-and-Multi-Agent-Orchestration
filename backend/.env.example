# Copy to .env and fill in. Both keys are optional — without them the
# pipeline runs on free, keyless sources and says so in the output.

# --- OpenAI ------------------------------------------------------------------
# The reasoning layer: ranks identity candidates, reads evidence, reviews the
# finished report. Without it everything falls back to the deterministic path.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. Defaults shown.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_USD_PER_MTOK_IN=0.15
# OPENAI_USD_PER_MTOK_OUT=0.60
# OPENAI_MAX_EXTRACT_CALLS=20

# --- Firecrawl ---------------------------------------------------------------
# Web search and page extraction. The only metered service.
FIRECRAWL_API_KEY=fc-your-key-here

# "trial" reports credits consumed and no cash cost, which is the truth on a
# free trial. Switch to "paid" once you are on a paying plan.
FIRECRAWL_PLAN=trial
FIRECRAWL_TRIAL_CREDITS=0

# --- collection budgets ------------------------------------------------------
# MAX_QUERIES_PER_ENTITY=15
# MAX_FULLTEXT_FETCHES=40
# MAX_FULLTEXT_FIRECRAWL=0

# --- CORS --------------------------------------------------------------------
# Any loopback port is allowed by default. Set to pin it down.
# ALLOWED_ORIGINS=http://localhost:3000
